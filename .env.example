TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
OPENROUTER_API_KEY=

OPENROUTER_MODEL=stealth/space-bunny-alpha

TARGET_USERNAME=mhmd59

PROACTIVE_ENABLED=true
MIN_PROACTIVE_INTERVAL_MINUTES=90
MAX_PROACTIVE_INTERVAL_MINUTES=180

# Optional, defaults shown
PORT=3000
MAX_RECENT_MESSAGES=30
SUMMARIZE_AFTER=40
MEMORY_FILE_PATH=/tmp/memory-store.json

# Style / behavior (defaults shown)
EMOJI_CHANCE=0.3
REPLY_DEBOUNCE_MS=3500
MAX_CONSECUTIVE_PROACTIVE=2
QUIET_START_HOUR=1
QUIET_END_HOUR=8
MAX_OUTPUT_TOKENS=1000
REASONING_EFFORT=low
